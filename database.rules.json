{
  "rules": {
    ".read": false,
    ".write": false,
    "comments": {
      ".read": true,
      "$commentId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'category', 'message', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "category": {
          ".validate": "newData.isString() && (newData.val() == 'Pesan' || newData.val() == 'Kesan' || newData.val() == 'Menfess')"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      },
      ".indexOn": ["createdAt"]
    }
  }
}
